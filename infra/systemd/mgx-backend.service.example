# Template for the MGX backend service.
# - Replace <USER> with the actual Unix user.
# - MGX_LOG_LEVEL typically stays "info" but can be changed to "debug"/"warning" for troubleshooting.
# - Copy to /etc/systemd/system/mgx-backend.service
# - Then run:
#     sudo systemctl daemon-reload
#     sudo systemctl enable mgx-backend.service
#     sudo systemctl start mgx-backend.service
# - After tweaking MGX_LOG_LEVEL remember to daemon-reload + restart.

[Unit]
Description=MGX Badugi FastAPI backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=<USER>
WorkingDirectory=/home/<USER>/badugi-app/backend
Environment=PYTHONUNBUFFERED=1
Environment=MGX_LOG_LEVEL=info
ExecStart=/home/<USER>/badugi-app/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --log-level ${MGX_LOG_LEVEL}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027

[Install]
WantedBy=multi-user.target
