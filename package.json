{
  "name": "badugi-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:tier1",
    "test:unit": "npm run test:tier1",
    "test:tier1": "vitest run --project=tier1",
    "test:tier2": "vitest run --project=tier2",
    "test:tier3": "node -e \"console.log('Tier3 includes AI/report-data dependent suites; ensure reports/data fixtures exist when needed.')\" && vitest run --project=tier3 --silent=passed-only",
    "test:tournament:review": "vitest run --project=tier2 src/ui/feedback/__tests__/tournamentReviewContract.test.js src/ui/components/__tests__/TournamentResultOverlay.test.jsx src/ui/components/__tests__/TournamentResultOverlay.coaching.test.jsx --silent=passed-only",
    "test:tournament:pr-e2e": "playwright test --project=tournament-pr-chromium",
    "test:tournament:resume": "vitest run --project=tier1 src/tournament/__tests__/startResumeRetire.test.js",
    "test:tournament:devices": "playwright test --project=tournament-android-chromium --project=tournament-iphone-webkit",
    "test:qm:tournament-production": "node scripts/run-production-tournament-qm.js",
    "test:tournament:webkit": "playwright test --project=tournament-iphone-webkit",
    "test:p2p": "vitest run src/ui/screens/__tests__/FriendMatchSetupScreen.test.jsx --project=tier2 && playwright test tests/e2e/p2p-friend-match-production-ws.spec.ts tests/e2e/p2p-friend-match-rest-fallback.spec.ts --project=badugi-flow",
    "test:p2p:contract": "vitest run --project=tier1 src/ui/utils/__tests__/roomApi.test.js && python -m pytest backend/tests/test_p2p_manager.py backend/tests/test_p2p_persistence.py",
    "test:p2p:multiprocess": "playwright test tests/e2e/p2p-friend-match-multiprocess.spec.ts --project=badugi-flow --workers=1",
    "test:history:contract": "vitest run --project=tier1 src/games/badugi/flow/__tests__/handReplay.test.js src/ui/utils/__tests__/handHistory.test.js src/ui/utils/__tests__/persistedHandHistory.test.js",
    "test:core5:pr-e2e": "playwright test tests/e2e/core5-cash-full-lifecycle-gate.spec.ts tests/e2e/core5-tournament-full-lifecycle-gate.spec.ts tests/e2e/core5-tournament-champion-lifecycle.spec.ts --project=badugi-flow",
    "test:cash:all-live": "MGX_ALL_LIVE_CASH_QA=1 playwright test tests/e2e/all-live-core5-cash-production.spec.ts --project=badugi-flow --workers=1",
    "test:qm:public-games": "vitest run --project=tier1 src/games/config/__tests__/variantAvailability.test.js src/games/config/__tests__/core5CashQmSummary.test.js",
    "qm:cash:summary": "node scripts/quality/summarize-core5-cash-qm.mjs reports/all-live-cash",
    "test:deploy:static": "bash scripts/deploy/test-mgx-prod-01-static.sh",
    "test:build:onnx": "node scripts/deploy/verify-built-onnx-assets.mjs",
    "test:ai-evaluation": "vitest run --project=tier3 src/ai/evaluation --silent=passed-only",
    "test:all:serial": "npm run test:tier1 -- --pool=forks --maxWorkers=1 --no-file-parallelism --silent=passed-only && npm run test:tier2 -- --pool=forks --maxWorkers=1 --no-file-parallelism --silent=passed-only && npm run test:tier3",
    "test:artifacts": "vitest run --config vitest.artifacts.config.js",
    "test:game:progress": "vitest run src/games/testing/progress src/games/testing/regression src/games/testing/scenario",
    "test:game:known-bugs": "vitest run src/games/testing/regression/gameProgressKnownBugs.test.js",
    "test:game:family": "vitest run src/games/testing/scenario/*FamilyProgress.test.js",
    "test:game:stud": "vitest run src/games/testing/scenario/studFamilyProgress.test.js",
    "test:qm:stud-razz-devices": "playwright test --project=stud-desktop-chromium --project=stud-android-chromium --project=stud-iphone-webkit --workers=1",
    "test:qm:nlh-release": "MGX_ALL_LIVE_CASH_QA=1 MGX_ALL_LIVE_CASH_VARIANTS=nlh MGX_ALL_LIVE_CASH_DEVICES=desktop,android playwright test tests/e2e/all-live-core5-cash-production.spec.ts --project=badugi-flow --workers=1 && MGX_ALL_LIVE_CASH_QA=1 MGX_ALL_LIVE_CASH_VARIANTS=nlh MGX_ALL_LIVE_CASH_DEVICES=iphone playwright test --project=nlh-cash-iphone-webkit --workers=1 && TOURNAMENT_QM_VARIANT=nlh playwright test --project=nlh-tournament-desktop-chromium --project=nlh-tournament-iphone-webkit --grep='\\[production QM\\]' --workers=1",
    "test:game:flop": "vitest run src/games/testing/scenario/flopFamilyProgress.test.js",
    "test:game:draw-family": "vitest run src/games/testing/scenario/drawFamilyProgress.test.js",
    "test:game:chinese": "vitest run src/games/testing/scenario/chineseFamilyProgress.test.js",
    "test:game:one-hand": "vitest run src/games/testing/scenario/allVariantsOneHandProgression.test.js src/games/testing/scenario/familyOneHandProgression.test.js",
    "test:game:ev": "vitest run src/games/testing/ev",
    "test:mgx:safety": "npm run test:game:known-bugs && npm run test:game:one-hand && npm run test:game:ev && npm run test:rl:safety",
    "test:rl:pipeline": "vitest run src/rl/__tests__/rlDataPipelineAudit.test.js src/rl/__tests__/badugiObservationSchema.test.js src/rl/__tests__/drawObservationSchema.test.js src/ai/__tests__/onnxPolicyAdapter.test.js src/ai/__tests__/onnxPolicyAdapterInference.test.js src/ai/__tests__/modelRouter.test.js",
    "test:rl:safety": "vitest run src/rl/testing/rlResumeSafetyGate.test.js src/rl/__tests__/rlDataPipelineAudit.test.js src/rl/__tests__/badugiObservationSchema.test.js src/rl/__tests__/drawObservationSchema.test.js src/ai/__tests__/onnxPolicyAdapter.test.js src/ai/__tests__/onnxPolicyAdapterInference.test.js src/ai/__tests__/modelRouter.test.js src/ai/__tests__/onnxFallbackSmoke.test.js",
    "test:ai:pro": "vitest run src/ai/pro",
    "eval:ai:pro": "node scripts/runAiProEvaluation.mjs",
    "eval:ai:divergence": "node scripts/runAiDivergenceAnalysis.mjs",
    "eval:ai:counterfactual": "node scripts/runAiCounterfactual.mjs",
    "eval:ai:compare-corpus": "node src/ai/evaluation/compareDivergenceCorpora.js",
    "eval:ai:export-action-value": "node scripts/runAiExportActionValue.mjs",
    "eval:ai:validate-action-value": "node src/ai/evaluation/validateActionValueDataset.js",
    "eval:ai:replay-determinism": "node scripts/runAiReplayDeterminism.mjs",
    "train:ai:iron:warmstart": "node src/ai/iron/trainIronWarmStart.js",
    "train:ai:iron:supervised": "node src/ai/iron/trainIronSupervisedPolicy.js",
    "eval:ai:iron:arena": "node scripts/runIronOfflineArena.mjs",
    "eval:ai:iron:forced-replay": "node scripts/runIronForcedReplayVitest.mjs",
    "monitor:ai:iron": "node scripts/runIronBenchmarkTelemetry.mjs",
    "rebalance:ai:iron-dataset": "node src/ai/iron/rebalanceIronDataset.js",
    "check:ai:iron-dataset": "node src/ai/iron/checkIronDatasetQuality.js",
    "test:ai:iron": "vitest run --project=tier3 src/ai/iron --silent=passed-only",
    "test:e2e:progress": "playwright test tests/e2e/mgx-game-progress.spec.js --project=badugi-flow",
    "test:e2e:progression": "playwright test tests/e2e/mgx-game-progression.spec.js --project=badugi-flow",
    "test:soak:fast": "playwright test tests/e2e/gameplay-soak-fast-db-telemetry.spec.ts --project=badugi-flow",
    "test:soak:core5": "SOAK_TIER=standard SOAK_SEEDS_PER_VARIANT=2 SOAK_MIN_EVENTS=10 SOAK_MAX_EVENTS=30 playwright test tests/e2e/gameplay-soak-core5-cash.spec.ts tests/e2e/gameplay-soak-core5-tournament.spec.ts --project=badugi-flow",
    "test:soak:mobile": "SOAK_TIER=standard SOAK_SEEDS_PER_VARIANT=1 SOAK_MIN_EVENTS=10 SOAK_MAX_EVENTS=30 SOAK_VIEWPORTS=portrait-390x844 playwright test tests/e2e/gameplay-soak-mobile-portrait.spec.ts --project=badugi-flow",
    "test:soak:exhaustive": "SOAK_TIER=exhaustive SOAK_SEEDS_PER_VARIANT=3 SOAK_MIN_EVENTS=30 SOAK_MAX_EVENTS=80 playwright test tests/e2e/gameplay-soak-core5-cash.spec.ts tests/e2e/gameplay-soak-core5-tournament.spec.ts tests/e2e/gameplay-soak-mobile-portrait.spec.ts --project=badugi-flow",
    "test:soak:core5-weekly": "node scripts/run-core5-long-run-soak.js --hands=20 --seeds=101,127 --modes=cash,tournament --timeout-ms=7200000",
    "test:scrape": "python -m tests.scraping.runner smoke",
    "variants:export": "node --experimental-json-modules scripts/exportVariants.mjs",
    "ai:verify-models": "node scripts/verifyAiModelAssets.mjs",
    "ai:install-models": "node scripts/installAiModelAssets.mjs",
    "ai:build-bootstrap-models": "node scripts/runPythonTool.mjs src/rl/training/build_badugi_bootstrap_onnx.py",
    "ai:build-draw-bootstrap-models": "node scripts/runPythonTool.mjs src/rl/training/build_draw_bootstrap_onnx.py",
    "ai:evaluate-draw-onnx": "node scripts/runPythonTool.mjs src/rl/training/evaluate_draw_onnx.py",
    "ai:evaluate-draw-selfplay": "node scripts/runPythonTool.mjs src/rl/training/evaluate_selfplay_draw.py",
    "ai:gate-draw-model": "node scripts/runPythonTool.mjs src/rl/training/gate_draw_model.py",
    "ai:train-badugi": "node scripts/runPythonTool.mjs src/rl/training/train_dqn.py",
    "ai:train-badugi-sixmax": "node scripts/runPythonTool.mjs src/rl/training/train_sixmax_selfplay_badugi_dqn.py",
    "ai:export-badugi-onnx": "node scripts/runPythonTool.mjs src/rl/training/export_badugi_dqn_onnx.py",
    "ai:evaluate-badugi-onnx": "node scripts/runPythonTool.mjs src/rl/training/evaluate_badugi_onnx.py",
    "ai:gate-badugi-model": "node scripts/runPythonTool.mjs src/rl/training/gate_badugi_model.py",
    "ai:evaluate-badugi-sixmax-clean": "node scripts/runPythonTool.mjs src/rl/training/evaluate_badugi_sixmax_clean.py",
    "ai:inventory-badugi-sixmax": "node scripts/runPythonTool.mjs src/rl/training/inventory_badugi_sixmax_checkpoints.py",
    "ai:summarize-badugi-phase2": "node scripts/runPythonTool.mjs src/rl/training/summarize_badugi_phase2_experiments.py",
    "ai:benchmark-badugi-human-practice": "node scripts/runPythonTool.mjs src/rl/training/benchmark_badugi_human_practice.py",
    "ai:evaluate-badugi-checkpoints": "node scripts/runPythonTool.mjs src/rl/training/evaluate_badugi_checkpoints.py",
    "ai:train-draw": "node scripts/runPythonTool.mjs src/rl/training/train_draw_dqn.py",
    "ai:export-draw-onnx": "node scripts/runPythonTool.mjs src/rl/training/export_draw_dqn_onnx.py",
    "ai:train-board": "node scripts/runPythonTool.mjs src/rl/training/train_board_dqn.py",
    "ai:export-board-onnx": "node scripts/runPythonTool.mjs src/rl/training/export_board_dqn_onnx.py",
    "ai:evaluate-board-onnx": "node scripts/runPythonTool.mjs src/rl/training/evaluate_board_onnx.py",
    "ai:train-stud": "node scripts/runPythonTool.mjs src/rl/training/train_stud_dqn.py",
    "ai:export-stud-onnx": "node scripts/runPythonTool.mjs src/rl/training/export_stud_dqn_onnx.py",
    "ai:evaluate-stud-onnx": "node scripts/runPythonTool.mjs src/rl/training/evaluate_stud_onnx.py",
    "ai:plan-10game-rl": "node scripts/runPythonTool.mjs src/rl/training/ten_game_rl_plan.py",
    "ai:benchmark-board-human-practice": "node scripts/runPythonTool.mjs src/rl/training/benchmark_board_human_practice.py"
  },
  "dependencies": {
    "onnxruntime-web": "^1.18.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^23.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
